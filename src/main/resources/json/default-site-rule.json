      "nextContentUrl": "@js:\nfunction execute() {\n    let nextElement = prePageElement.selectFirst('.bottem2 .next');\n    if (nextElement == null) {\n        return \"\";\n    }\n    if (loadingPage == 1) {\n        return chapterUrl;\n    }\n    let nextUrl = nextElement.attr(\"href\");\n    if (!nextUrl || nextUrl == '') {\n        return \"\";\n    }\n\n    let pattern = /_\\d+\\.html$/;\n    let isNextPage = pattern.test(nextUrl);\n    return isNextPage ? nextUrl : \"\";\n}\n(execute())",
